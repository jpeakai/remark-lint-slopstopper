{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": true,
  "files": { "includes": ["**", "!node_modules"] },
  "formatter": { "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "preset": "all",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 10 }
        }
      }
    }
  }
}
