{
  "name": "@jpeakai/remark-lint-slopstopper",
  "version": "0.1.2",
  "type": "module",
  "description": "Markdown lint policies and a standalone CLI for prose and Mermaid diagrams",
  "license": "MIT",
  "keywords": [
    "remark",
    "remark-lint",
    "remark-lint-rule",
    "markdown",
    "prose",
    "lint",
    "mermaid",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpeakai/remark-lint-slopstopper.git"
  },
  "homepage": "https://jpeakai.github.io/remark-lint-slopstopper/",
  "bugs": "https://github.com/jpeakai/remark-lint-slopstopper/issues",
  "packageManager": "bun@1.3.12",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "remark-lint-slopstopper": "dist/cli.js"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./index.ts",
      "default": "./dist/index.js"
    },
    "./remark": {
      "types": "./dist/types/src/remark/plugin.d.ts",
      "bun": "./src/remark/plugin.ts",
      "default": "./dist/src/remark/plugin.js"
    },
    "./document": {
      "types": "./dist/types/src/document/context.d.ts",
      "bun": "./src/document/context.ts",
      "default": "./dist/src/document/context.js"
    },
    "./language-view": {
      "types": "./dist/types/src/document/language-view.d.ts",
      "bun": "./src/document/language-view.ts",
      "default": "./dist/src/document/language-view.js"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "RULES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun build src/cli/main.ts --outfile dist/cli.js --target=node --packages=external && bun build index.ts src/remark/plugin.ts src/document/context.ts src/document/language-view.ts --root . --outdir dist --splitting --target=node --format=esm --packages=external && tsc --project config/tsconfig.build.json",
    "prepublishOnly": "bun run check",
    "prepack": "bun run build",
    "test": "bun test ./src",
    "test:node": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project config/tsconfig.json",
    "format": "biome check --write --unsafe --only=style/useBlockStatements index.ts src && bun run format:spacing && biome format --write .",
    "format:spacing": "eslint --fix index.ts src --max-warnings 0",
    "lint": "biome check --error-on-warnings . && bun run lint:spacing",
    "lint:spacing": "eslint index.ts src --max-warnings 0",
    "lint:dead-code": "knip --config config/knip.json && knip --config config/knip.json --production --strict",
    "check": "bun run typecheck && bun run build && bun run lint && bun run lint:dead-code && bun run test"
  },
  "dependencies": {
    "@mermaid-js/parser": "1.2.1",
    "@statelyai/graph": "2.6.0",
    "@types/mdast": "4.0.4",
    "colorjs.io": "0.6.1",
    "compromise": "14.18.0",
    "cytoscape": "3.34.4",
    "happy-dom": "20.9.0",
    "htmlparser2": "12.0.0",
    "khroma": "2.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mermaid": "11.17.2",
    "micromark-extension-frontmatter": "2.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-message-control": "8.0.0",
    "remark-parse": "11.0.0",
    "remark-preset-lint-recommended": "7.0.1",
    "stemmer": "2.0.1",
    "unified": "11.0.5",
    "unified-engine": "11.2.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "knip": "6.42.1",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "vfile": "6.0.3",
    "vfile-message": "4.0.3"
  }
}
