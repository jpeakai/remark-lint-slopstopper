{
  "name": "remark-lint-slopstopper",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./index.ts",
    "./remark": "./src/remark/plugin.ts",
    "./document": "./src/document/context.ts",
    "./language-view": "./src/document/language-view.ts"
  },
  "scripts": {
    "test": "bun test ./src",
    "test:node": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --project config/tsconfig.json",
    "lint": "biome lint .",
    "lint:dead-code": "knip --config config/knip.json && knip --config config/knip.json --production --strict",
    "check": "bun run typecheck && bun run lint && bun run lint:dead-code && bun run test"
  },
  "dependencies": {
    "@mermaid-js/parser": "1.2.1",
    "@statelyai/graph": "2.6.0",
    "colorjs.io": "0.6.1",
    "compromise": "14.18.0",
    "cytoscape": "3.34.4",
    "happy-dom": "20.9.0",
    "htmlparser2": "12.0.0",
    "khroma": "2.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mermaid": "11.17.2",
    "micromark-extension-frontmatter": "2.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-message-control": "8.0.0",
    "remark-parse": "11.0.0",
    "remark-preset-lint-recommended": "7.0.1",
    "stemmer": "2.0.1",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "@types/node": "26.2.0",
    "knip": "6.42.1",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "vfile": "6.0.3",
    "vfile-message": "4.0.3"
  }
}
