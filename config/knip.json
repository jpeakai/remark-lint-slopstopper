{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "src/cli/main.ts!",
    "examples/*.mjs",
    "examples/scripts/*.test.ts",
    "docs-site/diagrams.js"
  ],
  "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "examples/*.mjs", "examples/scripts/**/*.ts"],
  "ignoreBinaries": ["codex"],
  "ignoreExportsUsedInFile": true
}
